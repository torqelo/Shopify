<div class="torqelo-cart-assurance">
  <div class="torqelo-cart-policy-summary" aria-label="Order policies">
    <p><strong>Shipping:</strong> Orders process in 1–3 business days. Standard U.S. transit is typically 3–7 business days after processing. Your available shipping method and cost are shown at checkout.</p>
    <p><strong>Eligible returns:</strong> Request a return within 30 days after delivery. Customers pay ordinary return shipping; Torqelo covers return shipping for damaged, defective, or incorrect items. No restocking fee. Exclusions apply.</p>
    <p><a href="{{ routes.root_url }}policies/shipping-policy">Shipping policy</a> · <a href="{{ routes.root_url }}policies/refund-policy">Refund policy</a> · <a href="{{ routes.root_url }}policies/contact-information">Contact us</a></p>
  </div>
  {% assign upsell_collection = collections['new-arrivals'] %}
  {% if upsell_collection.products.size > 0 %}
    <div class="torqelo-cart-upsells">
      <h3>Complete your order</h3>
      {% assign shown = 0 %}
      {% for upsell_product in upsell_collection.products %}
        {% if shown >= 2 %}{% break %}{% endif %}
        {% assign already_in_cart = false %}
        {% for cart_item in cart.items %}
          {% if cart_item.product_id == upsell_product.id %}{% assign already_in_cart = true %}{% break %}{% endif %}
        {% endfor %}
        {% if upsell_product.available and already_in_cart == false %}
          {% assign upsell_alt = upsell_product.featured_image.alt | default: upsell_product.title %}
          <div class="torqelo-cart-upsell">
            {% if upsell_product.featured_image %}
              {{ upsell_product.featured_image | image_url: width: 160 | image_tag: loading: 'lazy', widths: '80, 160', alt: upsell_alt }}
            {% endif %}
            <div>
              <a href="{{ upsell_product.url }}">{{ upsell_product.title }}</a>
              <span>{{ upsell_product.price | money }}</span>
            </div>
            <form method="post" action="{{ routes.cart_add_url }}">
              <input type="hidden" name="id" value="{{ upsell_product.selected_or_first_available_variant.id }}">
              <input type="hidden" name="quantity" value="1">
              <button class="button button--secondary" type="submit" aria-label="Add {{ upsell_product.title | escape }} to cart">Add</button>
            </form>
          </div>
          {% assign shown = shown | plus: 1 %}
        {% endif %}
      {% endfor %}
    </div>
  {% endif %}
  <p class="torqelo-cart-reassurance">Secure checkout · Clear delivery costs · Straightforward returns</p>
</div>
