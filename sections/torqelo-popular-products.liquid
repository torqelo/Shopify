{% liquid
  assign featured_collection = section.settings.collection
  if featured_collection == blank
    assign featured_collection = collections.all
  endif
%}
<section class="torqelo-popular color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="title-wrapper-with-link">
      <div>{% if section.settings.eyebrow != blank %}<p class="caption-with-letter-spacing">{{ section.settings.eyebrow }}</p>{% endif %}<h2 class="title inline-richtext {{ section.settings.heading_size }}">{{ section.settings.title }}</h2></div>
      {% if section.settings.show_view_all %}<a href="{{ featured_collection.url }}" class="link underlined-link">View all</a>{% endif %}
    </div>
    <ul class="grid product-grid grid--2-col-tablet-down grid--5-col-desktop" role="list">
      {% assign available_products_shown = 0 %}
      {% for product in featured_collection.products %}
        {% if product.available == false %}{% continue %}{% endif %}
        {% if available_products_shown >= 5 %}{% break %}{% endif %}
        <li class="grid__item">
          {% render 'card-product', card_product: product, media_aspect_ratio: 'adapt', show_secondary_image: true, show_rating: true, quick_add: 'standard', section_id: section.id %}
        </li>
        {% assign available_products_shown = available_products_shown | plus: 1 %}
      {% else %}
        {% for i in (1..5) %}<li class="grid__item"><div class="card-wrapper product-card-wrapper">{{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}</div></li>{% endfor %}
      {% endfor %}
    </ul>
  </div>
</section>
{% style %}.section-{{ section.id }}-padding{padding-top:{{ section.settings.padding_top | times: 0.75 | round: 0 }}px;padding-bottom:{{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px}@media(min-width:750px){.section-{{ section.id }}-padding{padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px}}{% endstyle %}
{% schema %}
{"name":"Popular products","tag":"section","settings":[{"type":"inline_richtext","id":"title","label":"Heading","default":"Five customer favorites"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Popular right now"},{"type":"collection","id":"collection","label":"Collection","info":"Choose a best-selling or manually curated collection. Shopify analytics is required for true storewide view rankings."},{"type":"checkbox","id":"show_view_all","label":"Show view all","default":true},{"type":"select","id":"heading_size","label":"Heading size","options":[{"value":"h2","label":"Medium"},{"value":"h1","label":"Large"}],"default":"h2"},{"type":"color_scheme","id":"color_scheme","label":"Color scheme","default":"scheme-1"},{"type":"range","id":"padding_top","min":0,"max":100,"step":4,"unit":"px","label":"Top padding","default":48},{"type":"range","id":"padding_bottom","min":0,"max":100,"step":4,"unit":"px","label":"Bottom padding","default":48}],"presets":[{"name":"Popular products"}]}
{% endschema %}
