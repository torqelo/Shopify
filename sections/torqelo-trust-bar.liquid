<section class="torqelo-trust color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    {% if section.settings.heading != blank %}<h2 class="torqelo-trust__heading {{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>{% endif %}
    <div class="torqelo-trust__grid">
      {% for block in section.blocks %}
        <div class="torqelo-trust__item" {{ block.shopify_attributes }}>
          <span class="torqelo-trust__icon" aria-hidden="true">
            {% case block.settings.icon %}
              {% when 'delivery' %}{{ 'icon-truck.svg' | inline_asset_content }}
              {% when 'returns' %}{{ 'icon-return.svg' | inline_asset_content }}
              {% when 'support' %}{{ 'icon-chat-bubble.svg' | inline_asset_content }}
              {% else %}{{ 'icon-lock.svg' | inline_asset_content }}
            {% endcase %}
          </span>
          <div><h3>{{ block.settings.heading }}</h3><p>{{ block.settings.text }}</p></div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{"name":"Torqelo trust bar","settings":[{"type":"text","id":"heading","label":"Heading","default":"Shop with confidence"},{"type":"select","id":"heading_size","label":"Heading size","options":[{"value":"h2","label":"Medium"},{"value":"h1","label":"Large"}],"default":"h2"},{"type":"color_scheme","id":"color_scheme","label":"Color scheme","default":"scheme-2"}],"blocks":[{"type":"trust_item","name":"Trust item","limit":4,"settings":[{"type":"select","id":"icon","label":"Icon","options":[{"value":"secure","label":"Secure"},{"value":"delivery","label":"Delivery"},{"value":"returns","label":"Returns"},{"value":"support","label":"Support"}],"default":"secure"},{"type":"text","id":"heading","label":"Heading","default":"Secure checkout"},{"type":"text","id":"text","label":"Text","default":"Protected payment options"}]}],"presets":[{"name":"Torqelo trust bar","blocks":[{"type":"trust_item","settings":{"icon":"secure","heading":"Secure checkout","text":"Protected payment options"}},{"type":"trust_item","settings":{"icon":"delivery","heading":"Tracked delivery","text":"Clear updates on every order"}},{"type":"trust_item","settings":{"icon":"returns","heading":"Straightforward returns","text":"Clear policy and support"}},{"type":"trust_item","settings":{"icon":"support","heading":"Helpful support","text":"Questions answered promptly"}}]}]}
{% endschema %}
