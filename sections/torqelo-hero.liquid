{%- liquid
  assign hero_alt = section.settings.image.alt | default: section.settings.heading
-%}

<section class="torqelo-hero color-{{ section.settings.color_scheme }} gradient">
  <div class="torqelo-hero__grid">
    <div class="torqelo-hero__content">
      {%- if section.settings.eyebrow != blank -%}<p class="torqelo-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h1 class="torqelo-hero__heading">{{ section.settings.heading }}</h1>{%- endif -%}
      {%- if section.settings.text != blank -%}<div class="torqelo-hero__text rte">{{ section.settings.text }}</div>{%- endif -%}
      <div class="torqelo-hero__actions">
        {%- if section.settings.primary_label != blank -%}<a class="button" href="{{ section.settings.primary_link | default: routes.all_products_collection_url }}">{{ section.settings.primary_label | escape }}</a>{%- endif -%}
        {%- if section.settings.secondary_label != blank -%}<a class="button button--secondary" href="{{ section.settings.secondary_link | default: routes.collections_url }}">{{ section.settings.secondary_label | escape }}</a>{%- endif -%}
      </div>
    </div>
    <div class="torqelo-hero__media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1800 | image_tag: widths: '480, 720, 960, 1200, 1500, 1800', sizes: '(min-width: 990px) 50vw, 100vw', fetchpriority: 'high', alt: hero_alt }}
      {%- else -%}
        <div class="torqelo-hero__placeholder">{{ 'lifestyle-1' | placeholder_svg_tag }}</div>
      {%- endif -%}
      {%- if section.settings.proof_heading != blank -%}
        <div class="torqelo-hero__proof"><span aria-hidden="true">✦</span><div><strong>{{ section.settings.proof_heading | escape }}</strong><span>{{ section.settings.proof_text | escape }}</span></div></div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Torqelo advanced hero",
  "tag": "section",
  "settings": [
    {"type":"image_picker","id":"image","label":"Hero image"},
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Thoughtfully selected essentials"},
    {"type":"inline_richtext","id":"heading","label":"Heading","default":"Elevate the everyday."},
    {"type":"richtext","id":"text","label":"Text","default":"<p>Beautiful finds for your home, beauty routine and personal style—curated to make every day feel a little more special.</p>"},
    {"type":"text","id":"primary_label","label":"Primary button","default":"Shop best sellers"},
    {"type":"url","id":"primary_link","label":"Primary link"},
    {"type":"text","id":"secondary_label","label":"Secondary button","default":"New arrivals"},
    {"type":"url","id":"secondary_link","label":"Secondary link"},
    {"type":"text","id":"proof_heading","label":"Trust heading","default":"Shop with confidence"},
    {"type":"text","id":"proof_text","label":"Trust text","default":"Secure checkout and helpful support"},
    {"type":"color_scheme","id":"color_scheme","label":"Color scheme","default":"scheme-3"}
  ],
  "presets": [{"name":"Torqelo advanced hero"}]
}
{% endschema %}
