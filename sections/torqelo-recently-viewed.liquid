<section class="torqelo-recently-viewed page-width section-{{ section.id }}-padding" data-recently-viewed-section data-limit="{{ section.settings.products_to_show }}" hidden>
  <h2 class="title inline-richtext {{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
  <div class="torqelo-recently-viewed__grid" data-recently-viewed-grid></div>
</section>
{% style %}.section-{{ section.id }}-padding{padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px}{% endstyle %}
{% schema %}
{"name":"Recently viewed","settings":[{"type":"inline_richtext","id":"heading","label":"Heading","default":"Recently viewed"},{"type":"select","id":"heading_size","label":"Heading size","options":[{"value":"h2","label":"Medium"},{"value":"h1","label":"Large"}],"default":"h2"},{"type":"range","id":"products_to_show","min":2,"max":5,"step":1,"label":"Products","default":5},{"type":"range","id":"padding_top","min":0,"max":100,"step":4,"unit":"px","label":"Top padding","default":36},{"type":"range","id":"padding_bottom","min":0,"max":100,"step":4,"unit":"px","label":"Bottom padding","default":52}],"presets":[{"name":"Recently viewed"}]}
{% endschema %}
