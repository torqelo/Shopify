{% doc %}
  @prompt
    Create a premium, modern storefront with a deep purple-indigo-lavender color palette and glassmorphism aesthetic. Use these brand colors: Deep Plum #382A3D, Dark Purple #543C61, Deep Indigo #3A3982, Rich Violet #655898, Soft Lavender #7874AD, Light Lavender #9C86BE, Soft Blue-Lavender #94ADD9, Off-White #EBEBED, Primary Accent Purple #735FC4, Bright Blue #4F8FE8. Design features: floating translucent navigation bar with backdrop blur and rounded corners; immersive radial gradient background blending plum, purple, indigo, and lavender; glassmorphism cards with semi-transparent dark purple backgrounds, 16-24px rounded corners, soft shadows, and subtle white borders; primary buttons with purple-to-blue gradient (#735FC4 → #4F8FE8) with glow on hover; clean modern sans-serif typography in white and light lavender; subtle premium animations including hover transitions, card elevation, and fade-in sections; fully responsive across mobile, tablet, and desktop. The overall feel should be futuristic, high-end, dimensional, and Apple-inspired without copying Apple — like a next-generation premium e-commerce brand.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-glassmorphism-hero-{{ ai_gen_id }} {
    display: block;
    position: relative;
    width: 100%;
    min-height: {{ block.settings.section_height }}px;
    overflow: hidden;
    background: radial-gradient(
      ellipse at {{ block.settings.gradient_position }},
      {{ block.settings.gradient_color_1 }} 0%,
      {{ block.settings.gradient_color_2 }} 25%,
      {{ block.settings.gradient_color_3 }} 50%,
      {{ block.settings.gradient_color_4 }} 75%,
      {{ block.settings.gradient_color_5 }} 100%
    );
  }

  .ai-glassmorphism-hero__nav-{{ ai_gen_id }} {
    position: absolute;
    top: {{ block.settings.nav_top_spacing }}px;
    left: 50%;
    transform: translateX(-50%);
    width: calc(100% - {{ block.settings.nav_horizontal_margin }}px);
    max-width: {{ block.settings.nav_max_width }}px;
    background: {{ block.settings.nav_bg_color }};
    backdrop-filter: blur({{ block.settings.nav_blur }}px);
    border-radius: {{ block.settings.nav_border_radius }}px;
    border: {{ block.settings.nav_border_width }}px solid {{ block.settings.nav_border_color }};
    box-shadow: 0 {{ block.settings.nav_shadow_y }}px {{ block.settings.nav_shadow_blur }}px {{ block.settings.nav_shadow_color }};
    padding: {{ block.settings.nav_padding_vertical }}px {{ block.settings.nav_padding_horizontal }}px;
    z-index: 100;
    transition: all 0.3s ease;
  }

  .ai-glassmorphism-hero__nav-content-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
  }

  .ai-glassmorphism-hero__logo-{{ ai_gen_id }} {
    font-size: {{ block.settings.logo_size }}px;
    font-weight: 700;
    color: {{ block.settings.nav_text_color }};
    text-decoration: none;
    letter-spacing: -0.5px;
  }

  .ai-glassmorphism-hero__nav-links-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.nav_link_spacing }}px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .ai-glassmorphism-hero__nav-link-{{ ai_gen_id }} {
    color: {{ block.settings.nav_text_color }};
    text-decoration: none;
    font-size: {{ block.settings.nav_link_size }}px;
    font-weight: 500;
    transition: color 0.3s ease, transform 0.3s ease;
    opacity: 0.9;
  }

  .ai-glassmorphism-hero__nav-link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.nav_link_hover_color }};
    opacity: 1;
    transform: translateY(-1px);
  }

  .ai-glassmorphism-hero__content-{{ ai_gen_id }} {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: {{ block.settings.section_height }}px;
    padding: {{ block.settings.content_padding_top }}px {{ block.settings.content_padding_horizontal }}px {{ block.settings.content_padding_bottom }}px;
    text-align: center;
    z-index: 10;
  }

  .ai-glassmorphism-hero__card-{{ ai_gen_id }} {
    background: {{ block.settings.card_bg_color }};
    backdrop-filter: blur({{ block.settings.card_blur }}px);
    border-radius: {{ block.settings.card_border_radius }}px;
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
    box-shadow: 0 {{ block.settings.card_shadow_y }}px {{ block.settings.card_shadow_blur }}px {{ block.settings.card_shadow_color }};
    padding: {{ block.settings.card_padding }}px;
    max-width: {{ block.settings.card_max_width }}px;
    width: 100%;
    transition: transform 0.4s ease, box-shadow 0.4s ease;
  }

  .ai-glassmorphism-hero__card-{{ ai_gen_id }}:hover {
    transform: translateY(-{{ block.settings.card_hover_lift }}px);
    box-shadow: 0 {{ block.settings.card_hover_shadow_y }}px {{ block.settings.card_hover_shadow_blur }}px {{ block.settings.card_hover_shadow_color }};
  }

  .ai-glassmorphism-hero__heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 700;
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.heading_margin_bottom }}px;
    line-height: 1.2;
    letter-spacing: -1px;
  }

  .ai-glassmorphism-hero__subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    font-weight: 400;
    color: {{ block.settings.subheading_color }};
    margin: 0 0 {{ block.settings.subheading_margin_bottom }}px;
    line-height: 1.6;
    opacity: 0.95;
  }

  .ai-glassmorphism-hero__button-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background: linear-gradient(135deg, {{ block.settings.button_gradient_start }} 0%, {{ block.settings.button_gradient_end }} 100%);
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: 600;
    border-radius: {{ block.settings.button_border_radius }}px;
    border: none;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: 0 4px 15px rgba(115, 95, 196, 0.3);
  }

  .ai-glassmorphism-hero__button-{{ ai_gen_id }}:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(115, 95, 196, 0.5), 0 0 30px rgba(115, 95, 196, 0.4);
  }

  .ai-glassmorphism-hero__features-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: {{ block.settings.feature_gap }}px;
    margin-top: {{ block.settings.features_margin_top }}px;
    padding: 0 {{ block.settings.content_padding_horizontal }}px;
    max-width: {{ block.settings.features_max_width }}px;
    width: 100%;
    margin-left: auto;
    margin-right: auto;
  }

  .ai-glassmorphism-hero__feature-card-{{ ai_gen_id }} {
    background: {{ block.settings.feature_card_bg }};
    backdrop-filter: blur({{ block.settings.feature_card_blur }}px);
    border-radius: {{ block.settings.feature_card_radius }}px;
    border: {{ block.settings.feature_card_border_width }}px solid {{ block.settings.feature_card_border_color }};
    padding: {{ block.settings.feature_card_padding }}px;
    text-align: center;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
  }

  .ai-glassmorphism-hero__feature-card-{{ ai_gen_id }}:hover {
    transform: translateY(-8px);
    box-shadow: 0 12px 30px rgba(115, 95, 196, 0.2);
  }

  .ai-glassmorphism-hero__feature-icon-{{ ai_gen_id }} {
    width: {{ block.settings.feature_icon_size }}px;
    height: {{ block.settings.feature_icon_size }}px;
    margin: 0 auto {{ block.settings.feature_icon_margin }}px;
    background: linear-gradient(135deg, {{ block.settings.button_gradient_start }} 0%, {{ block.settings.button_gradient_end }} 100%);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: {{ block.settings.button_text_color }};
  }

  .ai-glassmorphism-hero__feature-icon-{{ ai_gen_id }} svg {
    width: calc({{ block.settings.feature_icon_size }}px * 0.5);
    height: calc({{ block.settings.feature_icon_size }}px * 0.5);
  }

  .ai-glassmorphism-hero__feature-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.feature_title_size }}px;
    font-weight: 600;
    color: {{ block.settings.heading_color }};
    margin: 0 0 8px;
  }

  .ai-glassmorphism-hero__feature-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.feature_text_size }}px;
    color: {{ block.settings.subheading_color }};
    margin: 0;
    line-height: 1.5;
    opacity: 0.9;
  }

  @media screen and (max-width: 989px) {
    .ai-glassmorphism-hero-{{ ai_gen_id }} {
      min-height: {{ block.settings.section_height | times: 0.8 }}px;
    }

    .ai-glassmorphism-hero__content-{{ ai_gen_id }} {
      min-height: {{ block.settings.section_height | times: 0.8 }}px;
      padding: {{ block.settings.content_padding_top | times: 0.8 }}px 24px {{ block.settings.content_padding_bottom | times: 0.8 }}px;
    }

    .ai-glassmorphism-hero__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.7 }}px;
    }

    .ai-glassmorphism-hero__subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size | times: 0.9 }}px;
    }

    .ai-glassmorphism-hero__nav-links-{{ ai_gen_id }} {
      display: none;
    }

    .ai-glassmorphism-hero__features-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      padding: 0 20px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-glassmorphism-hero__card-{{ ai_gen_id }} {
      padding: {{ block.settings.card_padding | times: 0.7 }}px;
    }

    .ai-glassmorphism-hero__nav-{{ ai_gen_id }} {
      width: calc(100% - 32px);
    }
  }
{% endstyle %}

<glassmorphism-hero-{{ ai_gen_id }} class="ai-glassmorphism-hero-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.show_navigation %}
    <nav class="ai-glassmorphism-hero__nav-{{ ai_gen_id }}">
      <div class="ai-glassmorphism-hero__nav-content-{{ ai_gen_id }}">
        <a href="{{ block.settings.logo_link }}" class="ai-glassmorphism-hero__logo-{{ ai_gen_id }}">
          {{ block.settings.logo_text }}
        </a>
        <ul class="ai-glassmorphism-hero__nav-links-{{ ai_gen_id }}">
          {% if block.settings.nav_link_1_text != blank %}
            <li>
              <a href="{{ block.settings.nav_link_1_url }}" class="ai-glassmorphism-hero__nav-link-{{ ai_gen_id }}">
                {{ block.settings.nav_link_1_text }}
              </a>
            </li>
          {% endif %}
          {% if block.settings.nav_link_2_text != blank %}
            <li>
              <a href="{{ block.settings.nav_link_2_url }}" class="ai-glassmorphism-hero__nav-link-{{ ai_gen_id }}">
                {{ block.settings.nav_link_2_text }}
              </a>
            </li>
          {% endif %}
          {% if block.settings.nav_link_3_text != blank %}
            <li>
              <a href="{{ block.settings.nav_link_3_url }}" class="ai-glassmorphism-hero__nav-link-{{ ai_gen_id }}">
                {{ block.settings.nav_link_3_text }}
              </a>
            </li>
          {% endif %}
          {% if block.settings.nav_link_4_text != blank %}
            <li>
              <a href="{{ block.settings.nav_link_4_url }}" class="ai-glassmorphism-hero__nav-link-{{ ai_gen_id }}">
                {{ block.settings.nav_link_4_text }}
              </a>
            </li>
          {% endif %}
        </ul>
      </div>
    </nav>
  {% endif %}

  <div class="ai-glassmorphism-hero__content-{{ ai_gen_id }}">
    <div class="ai-glassmorphism-hero__card-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h1 class="ai-glassmorphism-hero__heading-{{ ai_gen_id }}">
          {{ block.settings.heading }}
        </h1>
      {% endif %}

      {% if block.settings.subheading != blank %}
        <p class="ai-glassmorphism-hero__subheading-{{ ai_gen_id }}">
          {{ block.settings.subheading }}
        </p>
      {% endif %}

      {% if block.settings.button_text != blank %}
        <a href="{{ block.settings.button_link }}" class="ai-glassmorphism-hero__button-{{ ai_gen_id }}">
          {{ block.settings.button_text }}
        </a>
      {% endif %}
    </div>

    {% if block.settings.show_features %}
      <div class="ai-glassmorphism-hero__features-{{ ai_gen_id }}">
        {% if block.settings.feature_1_title != blank %}
          <div class="ai-glassmorphism-hero__feature-card-{{ ai_gen_id }}">
            <div class="ai-glassmorphism-hero__feature-icon-{{ ai_gen_id }}">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
            <h3 class="ai-glassmorphism-hero__feature-title-{{ ai_gen_id }}">
              {{ block.settings.feature_1_title }}
            </h3>
            <p class="ai-glassmorphism-hero__feature-text-{{ ai_gen_id }}">
              {{ block.settings.feature_1_text }}
            </p>
          </div>
        {% endif %}

        {% if block.settings.feature_2_title != blank %}
          <div class="ai-glassmorphism-hero__feature-card-{{ ai_gen_id }}">
            <div class="ai-glassmorphism-hero__feature-icon-{{ ai_gen_id }}">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
              </svg>
            </div>
            <h3 class="ai-glassmorphism-hero__feature-title-{{ ai_gen_id }}">
              {{ block.settings.feature_2_title }}
            </h3>
            <p class="ai-glassmorphism-hero__feature-text-{{ ai_gen_id }}">
              {{ block.settings.feature_2_text }}
            </p>
          </div>
        {% endif %}

        {% if block.settings.feature_3_title != blank %}
          <div class="ai-glassmorphism-hero__feature-card-{{ ai_gen_id }}">
            <div class="ai-glassmorphism-hero__feature-icon-{{ ai_gen_id }}">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </div>
            <h3 class="ai-glassmorphism-hero__feature-title-{{ ai_gen_id }}">
              {{ block.settings.feature_3_title }}
            </h3>
            <p class="ai-glassmorphism-hero__feature-text-{{ ai_gen_id }}">
              {{ block.settings.feature_3_text }}
            </p>
          </div>
        {% endif %}
      </div>
    {% endif %}
  </div>
</glassmorphism-hero-{{ ai_gen_id }}>

<script>
  (function() {
    class GlassmorphismHero{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.setupScrollEffect();
      }

      setupScrollEffect() {
        const nav = this.querySelector('.ai-glassmorphism-hero__nav-{{ ai_gen_id }}');
        if (!nav) return;

        let lastScroll = 0;
        
        window.addEventListener('scroll', () => {
          const currentScroll = window.pageYOffset;
          
          if (currentScroll > lastScroll && currentScroll > 100) {
            nav.style.transform = 'translateX(-50%) translateY(-100%)';
            nav.style.opacity = '0';
          } else {
            nav.style.transform = 'translateX(-50%) translateY(0)';
            nav.style.opacity = '1';
          }
          
          lastScroll = currentScroll;
        });
      }
    }

    customElements.define('glassmorphism-hero-{{ ai_gen_id }}', GlassmorphismHero{{ ai_gen_id }});
  })();
</script>

